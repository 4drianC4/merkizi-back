meta {
  name: PATCH products.update
  type: http
  seq: 50
}

patch {
  url: {{URLBase}}/api/v1/products/{{productId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Cafe",
    "sku": "CAFE-001",
    "category_id": "{{categoryId}}",
    "price": "15.00",
    "status": "active"
  }
}

meta {
  name: GET categories.index
  type: http
  seq: 28
}

get {
  url: {{URLBase}}/api/v1/categories?parent_id=null
  body: none
  auth: none
}

params:query {
  parent_id: null
}

docs {
  Permiso: catalogo.categorias.ver. 200 data[] incluye parent_id, children[], products_count y children_count.
  parent_id=null lista las categorías raíz; un UUID filtra por padre. Sin el filtro se listan todas.
  Orden estable por nombre e ID.
}

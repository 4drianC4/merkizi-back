meta {
  name: POST roles.store
  type: http
  seq: 105
}

post {
  url: {{URLBase}}/api/v1/roles
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Cajero personalizado",
    "description": "Rol de caja con permisos seleccionados",
    "permission_ids": [
      "{{permissionId}}"
    ]
  }
}

docs {
  Requiere roles.crear. Solo se pueden asignar permisos que el administrador posee.
  Obtén permissionId desde GET permissions.index.
}

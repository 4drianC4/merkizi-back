meta {
  name: PUT employees.update
  type: http
  seq: 37
}

put {
  url: {{URLBase}}/api/v1/employees/{{employeeId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Empleado de prueba",
    "role_id": "{{roleId}}",
    "branch_ids": [
      "{{branchId}}"
    ],
    "primary_branch_id": "{{branchId}}"
  }
}

docs {
  Obtén roleId desde GET roles.index y branchId desde GET branches.index.
  Para personalizar permisos usa PUT employees.permissions.update después de crear el empleado.
}

meta {
  name: PATCH employees.update
  type: http
  seq: 38
}

patch {
  url: {{URLBase}}/api/v1/employees/{{employeeId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Empleado de prueba",
    "branch_id": "{{branchId}}",
    "user_id": null,
    "role": "employee",
    "status": "active"
  }
}
